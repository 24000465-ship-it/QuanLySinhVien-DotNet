<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- useLegacyV2RuntimeActivationPolicy: Crystal Reports cần thiết lập này để chạy trên .NET 4.x -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Đổi máy chỉ cần sửa dòng này. Tài khoản qlsv_app được tạo trong Database\QLSV.sql -->
    <add name="QLSV"
         connectionString="Server=localhost;Port=3306;Database=qlsv;Uid=qlsv_app;Pwd=Qlsv@2026;CharSet=utf8mb4;SslMode=Disabled;AllowPublicKeyRetrieval=True"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
